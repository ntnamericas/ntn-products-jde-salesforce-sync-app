%dw 2.0
output text/plain
--- 
"WITH TARGET_IDS AS (
    /* Captures the 100 IDs from the Mule Batch Aggregator */
    SELECT COLUMN_VALUE AS REQ_LITM 
    FROM TABLE(CAST(:targetIds AS SYS.ODCIVARCHAR2LIST))
),
IBLTLV_BASE AS (
    /* Get core attributes for only the 100 target records */
    SELECT 
        TRIM(F2.IBLITM) AS IBLITM, 
        TRIM(F2.IBITM) AS IBITM, 
        TRIM(F2.IBPRP1) AS IBPRP1, 
        TRIM(F2.IBSRP4) AS IBSRP4,
        TRIM(F1.IMDRAW) AS IMDRAW
    FROM PRODDTA.F4102 F2
    INNER JOIN PRODDTA.F4101 F1 ON TRIM(F2.IBITM) = F1.IMITM
    INNER JOIN TARGET_IDS TI ON TRIM(F2.IBLITM) = TI.REQ_LITM
    WHERE TRIM(F2.IBMCU) = '1801'
),
RELATED_DRAW_PARTS AS (
    /* Query all IMLITM where IMDRAW, PRP1, and SRP4 match our target set */
    SELECT 
        B.IBLITM AS ORIGINAL_LITM,
        TRIM(F1_REL.IBLITM) AS RELATED_LITM
    FROM IBLTLV_BASE B
    INNER JOIN PRODDTA.F4101 F1_REL ON B.IMDRAW = TRIM(F1_REL.IMDRAW)
    INNER JOIN PRODDTA.F4102 F2_REL ON F1_REL.IMITM = F2_REL.IBITM
    WHERE TRIM(F2_REL.IBMCU) = '1801'
    AND TRIM(F2_REL.IBPRP1) = B.IBPRP1
    AND TRIM(F2_REL.IBSRP4) = B.IBSRP4
),
MINMAX_CALC AS (
    /* Calculate Min/Max for the DRAW collection */
    SELECT 
        RDP.ORIGINAL_LITM,
        MIN(F2_FINAL.IBLTLV) AS GROUP_MIN,
        MAX(F2_FINAL.IBLTLV) AS GROUP_MAX
    FROM RELATED_DRAW_PARTS RDP
    INNER JOIN PRODDTA.F4102 F2_FINAL ON RDP.RELATED_LITM = TRIM(F2_FINAL.IBLITM)
    WHERE TRIM(F2_FINAL.IBMCU) = '1801'
    GROUP BY RDP.ORIGINAL_LITM
)
SELECT 
    MC.ORIGINAL_LITM AS External_ID__c,
    MC.GROUP_MIN AS Estimated_Production_Lead_Time_Min__c,
    MC.GROUP_MAX AS Estimated_Production_Lead_Time_Max__c
FROM MINMAX_CALC MC"